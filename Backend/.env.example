PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/rozer_that?retryWrites=true&w=majority
CORS_ORIGIN=https://your-frontend.vercel.app

# JWT Access Token Security
ACCESS_TOKEN_SECRET=rozer_that_access_token_secret_key_2026_production
ACCESS_TOKEN_EXPIRY=1d

# JWT Refresh Token Security
REFRESH_TOKEN_SECRET=rozer_that_refresh_token_secret_key_2026_production
REFRESH_TOKEN_EXPIRY=10d

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
